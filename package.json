{
  "name": "ai-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.10",
      "prismjs": "1.30.0"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @ai-workspace/web dev",
    "build": "pnpm -r build",
    "cdk": "pnpm --filter @ai-workspace/infra cdk",
    "cdk:synth": "pnpm --filter @ai-workspace/infra cdk:synth",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "audit:prod": "pnpm audit --prod",
    "start": "pnpm --filter @ai-workspace/web start"
  }
}
