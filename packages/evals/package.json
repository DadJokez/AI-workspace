{
  "name": "@ai-workspace/evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Self-running eval harness (specs/004): real-model behavior cases per capability, deterministic + judge assertions. Cases are data, not code.",
  "exports": {
    "./portability": "./src/portability/context-portability.ts",
    "./conformance": "./src/conformance/index.ts"
  },
  "scripts": {
    "eval": "tsx src/run.ts",
    "eval:core": "tsx src/run.ts --core",
    "eval:routing": "tsx src/run.ts model-routing",
    "benchmark:routing": "tsx src/benchmarks/run-model-routing.ts",
    "transcripts:replay": "tsx src/transcripts/replay.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "benchmark:discovery": "tsx src/benchmarks/run-tool-discovery.ts",
    "conformance:offline": "tsx src/conformance/run.ts --offline"
  },
  "dependencies": {
    "@ai-workspace/agent": "workspace:*",
    "@ai-workspace/agent-runtime": "workspace:*",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0",
    "vitest": "^3.2.6"
  }
}
