      "Resource": "arn:aws:iam::351478076796:role/AiWorkspaceAgentCoreSpikeS-AgentRuntimeRole5365C2E6-jABpfc9ZBB94",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "bedrock-agentcore.amazonaws.com"
