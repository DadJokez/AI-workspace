# Secrets Manager secrets of the environment, comparative/<env>/<name>.
#
# Terraform creates each secret, its encryption and its resource policy. It
# writes a value to exactly one of them, browser-proxy, and that value never
# reaches the plan or the state. The others are shells a human fills; see
# ../../README.md, "After the first apply of 20-data".

locals {
  secrets = merge(
    {
      "app"              = "Application secrets, one JSON field per variable. Value written by a human."
      "browser-proxy-db" = "DATABASE_URL of the egress proxy's read-only database login. Value written by a human."
      "browser-proxy"    = "Basic auth used only between AgentCore Browser and the governed egress proxy. Value generated by Terraform."
    },
    var.enable_rds_proxy ? {
      "db-proxy-auth" = "Database login RDS Proxy connects with, as JSON username and password. Value written by a human."
    } : {},
  )

  browser_proxy_username = "comparative-browser"
}

resource "aws_secretsmanager_secret" "this" {
  #checkov:skip=CKV2_AWS_57:Values are OAuth client secrets and logins a human writes, plus one credential rotated by raising secret_string_wo_version; there is no rotation function
  for_each = local.secrets

  name        = "comparative/${var.env}/${each.key}"
  description = each.value
  kms_key_id  = var.secrets_kms_key_arn
}

# Access is granted by identity policies inside the account. This policy only
# refuses every other account, whatever is granted later.
resource "aws_secretsmanager_secret_policy" "this" {
  for_each = local.secrets

  secret_arn          = aws_secretsmanager_secret.this[each.key].arn
  block_public_policy = true

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid       = "DenyOtherAccounts"
      Effect    = "Deny"
      Principal = "*"
      Action    = "secretsmanager:*"
      Resource  = "*"
      Condition = {
        StringNotEquals = { "aws:PrincipalAccount" = var.account_id }
      }
    }]
  })
}

# --- The generated browser-proxy credential ------------------------------------

# Ephemeral: the password exists only while Terraform runs. It is regenerated
# on every run and discarded unless the version below is being created.
ephemeral "random_password" "browser_proxy" {
  length  = 48
  special = false
}

# secret_string_wo is write-only: it is sent to Secrets Manager and stored in
# neither the plan nor the state. Terraform cannot see a write-only value
# change, so the password is written when this resource is created and again
# only when secret_string_wo_version changes: raise the number to rotate, then
# restart the services that read the secret.
resource "aws_secretsmanager_secret_version" "browser_proxy" {
  secret_id = aws_secretsmanager_secret.this["browser-proxy"].id

  secret_string_wo = jsonencode({
    username = local.browser_proxy_username
    password = ephemeral.random_password.browser_proxy.result
  })
  secret_string_wo_version = 1
}
