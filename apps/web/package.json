{
  "name": "@ai-workspace/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-agentcore-dcv.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-agentcore-dcv.mjs",
    "build": "next build",
    "start": "next start",
    "worker:chat-runs": "tsx scripts/chat-run-worker.ts",
    "worker:memory-capture": "tsx scripts/memory-capture-worker.ts",
    "browser:egress-proxy": "tsx scripts/browser-egress-proxy.ts",
    "memory:backfill": "tsx scripts/backfill-memory-captures.ts",
    "audit:retention": "tsx scripts/audit-retention.ts",
    "audit:canceled-run-results": "tsx scripts/audit-canceled-run-results.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke:browser": "playwright test",
    "smoke:browser:auth": "DATABASE_URL=${DATABASE_URL:-postgres://aihub:aihub_dev@localhost:5432/aihub} pnpm --filter @ai-workspace/db db:migrate && DATABASE_URL=${DATABASE_URL:-postgres://aihub:aihub_dev@localhost:5432/aihub} tsx scripts/seed-auth-smoke.ts && PLAYWRIGHT_AUTH_SMOKE=1 DATABASE_URL=${DATABASE_URL:-postgres://aihub:aihub_dev@localhost:5432/aihub} playwright test e2e/authenticated-smoke.spec.ts --project=desktop-chromium",
    "smoke:browser:core": "DATABASE_URL=${DATABASE_URL:-postgres://aihub:aihub_dev@localhost:5432/aihub} pnpm --filter @ai-workspace/db db:migrate && DATABASE_URL=${DATABASE_URL:-postgres://aihub:aihub_dev@localhost:5432/aihub} tsx scripts/seed-auth-smoke.ts && PLAYWRIGHT_CORE_EVAL=1 DATABASE_URL=${DATABASE_URL:-postgres://aihub:aihub_dev@localhost:5432/aihub} playwright test e2e/core-chat-resource.spec.ts --project=desktop-chromium",
    "smoke:prod:auth": "tsx scripts/production-auth-smoke.ts",
    "smoke:browser:ui": "playwright test --ui",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "seed:load-users": "DATABASE_URL=${DATABASE_URL:-postgres://aihub:aihub_dev@localhost:5432/aihub} tsx scripts/seed-load-users.ts"
  },
  "dependencies": {
    "@ai-workspace/agent": "workspace:*",
    "@ai-workspace/agent-runtime": "workspace:*",
    "@ai-workspace/auth": "workspace:*",
    "@ai-workspace/db": "workspace:*",
    "@ai-workspace/umber": "workspace:*",
    "@aws-sdk/client-bedrock-agentcore": "^3.1067.0",
    "@babel/runtime": "^7.29.7",
    "@cloudscape-design/components": "^3.0.1343",
    "@cloudscape-design/design-tokens": "^3.0.105",
    "@cloudscape-design/global-styles": "^1.0.66",
    "bedrock-agentcore": "0.4.3",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "next": "^15.5.21",
    "next-auth": "^4.24.15",
    "pdf-parse": "^2.4.5",
    "posthog-js": "^1.407.0",
    "posthog-node": "^5.46.0",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@ai-workspace/evals": "workspace:*",
    "@eslint/eslintrc": "^3.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.0",
    "@vitest/coverage-v8": "3.2.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.5.18",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.6"
  }
}
