# NextAuth v4 + GitHub OAuth.
# - NEXTAUTH_URL: public origin of the deployed app, e.g. http://localhost:3000
#   for local dev. Used as the base for OAuth redirects and invite links.
# - NEXTAUTH_SECRET: random 32+ byte secret. Generate with `openssl rand -base64 32`.
# - GITHUB_AUTH_CLIENT_ID / GITHUB_AUTH_CLIENT_SECRET: a *separate* GitHub OAuth
#   App from the per-user MCP-token flow below. The auth app's callback URL is
#   `${NEXTAUTH_URL}/api/auth/callback/github`.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GITHUB_AUTH_CLIENT_ID=
GITHUB_AUTH_CLIENT_SECRET=

# Postgres connection. docker-compose.yml provisions the local instance.
DATABASE_URL=postgres://aihub:aihub_dev@localhost:5432/aihub

# LLM client selector. `fake` echoes responses for local dev without AWS.
# `real` (lands in PR #7) calls AWS Bedrock.
BEDROCK_CLIENT=fake

# GitHub OAuth App for the per-user MCP-token flow at /api/oauth/github/*.
# Distinct from GITHUB_AUTH_* — that one is for sign-in identity; this one is
# for issuing per-user GitHub tokens that the GitHub MCP server uses on the
# user's behalf. Scope is `repo read:user`.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AES-256-GCM key (base64) for encrypting OAuth provider tokens at rest.
# Generate with `openssl rand -base64 32`. Required when /api/oauth/github/*
# is exercised; not required for sign-in.
OAUTH_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Agent runtime selector.
# ----------------------------------------------------------------------------
# Defaults to `cursor`. Set to `bedrock` to use Bedrock instead.
RUNTIME=cursor
# Required for RUNTIME=cursor. Cursor API key for the agent SDK.
CURSOR_API_KEY=
# Cursor SDK execution substrate default. Normal chat should stay `local`;
# the chat UI/API can explicitly select `cloud` for long-running work.
CURSOR_RUNTIME_MODE=local
# Optional when CURSOR_RUNTIME_MODE=cloud. Set for repo-backed coding/artifact
# runs; leave empty for general knowledge work.
CURSOR_CLOUD_REPO_URL=
CURSOR_CLOUD_REPO_REF=
CURSOR_CLOUD_ENV_TYPE=cloud
CURSOR_CLOUD_ENV_NAME=

# Prompt/context guardrails for fresh-agent-per-turn execution.
# Current user message is always preserved; older context is bounded.
CHAT_RECENT_MESSAGE_LIMIT=12
CHAT_CONTEXT_CHAR_LIMIT=120000
CHAT_CONTEXT_MESSAGE_CHAR_LIMIT=24000

# Pilot request/cost guardrails. These are process-local today and should move
# to Redis/shared storage before horizontally scaled ECS/Fargate rollout.
CHAT_MAX_REQUEST_BYTES=262144
CHAT_MAX_MESSAGE_CHARS=24000
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_REQUESTS=30

# Background chat-run worker. Local/App Runner can use the in-process bridge;
# ECS web tasks should set this to 0 and run the dedicated worker service.
CHAT_RUN_IN_PROCESS_WORKER=1
CHAT_RUN_WORKER_LEASE_MS=600000
CHAT_WORKER_RUNTIME_TIMEOUT_MS=3600000
CHAT_RUN_PROVIDER_POLL_INTERVAL_MS=15000

# Vault memory capture. Local/App Runner can use the in-process scheduler:
# a successful chat queues capture work and runs a batch 20 minutes later.
# ECS web tasks should set this to 0 and run the dedicated memory worker.
MEMORY_CAPTURE_IN_PROCESS_SCHEDULER=1
MEMORY_CAPTURE_DELAY_MS=1200000
MEMORY_CAPTURE_WORKER_POLL_INTERVAL_MS=3600000
MEMORY_CAPTURE_BATCH_LIMIT=40
MEMORY_CAPTURE_PROCESSING_STALE_MS=1800000
MEMORY_CAPTURE_MODEL_ID=sonnet-4-6
