# NextAuth v4 + GitHub OAuth.
# - NEXTAUTH_URL: public origin of the deployed app, e.g. http://localhost:3000
#   for local dev. Used as the base for OAuth redirects and invite links.
# - NEXTAUTH_SECRET: random 32+ byte secret. Generate with `openssl rand -base64 32`.
# - GITHUB_AUTH_CLIENT_ID / GITHUB_AUTH_CLIENT_SECRET: a *separate* GitHub OAuth
#   App from the per-user MCP-token flow below. The auth app's callback URL is
#   `${NEXTAUTH_URL}/api/auth/callback/github`.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GITHUB_AUTH_CLIENT_ID=
GITHUB_AUTH_CLIENT_SECRET=

# Postgres connection. docker-compose.yml provisions the local instance.
DATABASE_URL=postgres://aihub:aihub_dev@localhost:5432/aihub

# LLM client selector. `fake` echoes responses for local dev without AWS.
# `real` (lands in PR #7) calls AWS Bedrock.
BEDROCK_CLIENT=fake

# GitHub OAuth App for the per-user MCP-token flow at /api/oauth/github/*.
# Distinct from GITHUB_AUTH_* — that one is for sign-in identity; this one is
# for issuing per-user GitHub tokens that the GitHub MCP server uses on the
# user's behalf. Scope is `repo read:user`.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AES-256-GCM key (base64) for encrypting OAuth provider tokens at rest.
# Generate with `openssl rand -base64 32`. Required when /api/oauth/github/*
# is exercised; not required for sign-in.
OAUTH_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Spike-only (spike/cursor-sdk-runtime branch). Unused on main.
# ----------------------------------------------------------------------------
# Selects the agent runtime when the spike is wired through to apps/web.
# Defaults to `bedrock` so existing dev loops keep working. `cursor` selects
# packages/cursor-runtime, which is currently a stub and throws on use.
RUNTIME=bedrock
# Required if RUNTIME=cursor and the stub is replaced with a live integration.
# CURSOR_API_KEY=
