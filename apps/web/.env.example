# NextAuth v4 + GitHub OAuth.
# - NEXTAUTH_URL: public origin of the deployed app, e.g. http://localhost:3000
#   for local dev. Used as the base for OAuth redirects and invite links.
# - NEXTAUTH_SECRET: random 32+ byte secret. Generate with `openssl rand -base64 32`.
# - GITHUB_AUTH_CLIENT_ID / GITHUB_AUTH_CLIENT_SECRET: a *separate* GitHub OAuth
#   App from the per-user MCP-token flow below. The auth app's callback URL is
#   `${NEXTAUTH_URL}/api/auth/callback/github`.
NEXTAUTH_URL=http://localhost:3000
# - INTERNAL_BASE_URL (optional): private-network origin of this app. When set,
#   workers and the agent runtime call the app's MCP facades on it instead of
#   NEXTAUTH_URL, and the facades accept its host. Browser redirects stay public.
# INTERNAL_BASE_URL=
# - Outbound proxy (optional): set HTTPS_PROXY, HTTP_PROXY and NO_PROXY and start
#   Node with NODE_USE_ENV_PROXY=1. Without that flag the proxy variables are
#   ignored. NO_PROXY is an explicit host list (VPC endpoints, internal hosts).
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=
# - ENABLED_CONNECTOR_PROVIDERS (optional): comma list of connectors this
#   deployment offers (github, notion, google, salesforce). Unset or blank means
#   all of them. A connector left out has no settings card, its routes return
#   404, and the assistant is told it is not offered.
# ENABLED_CONNECTOR_PROVIDERS=
# - GITHUB_WEB_URL, GITHUB_API_URL, GITHUB_MCP_URL (optional): GitHub hosts.
#   Unset means github.com (https://github.com, https://api.github.com,
#   https://api.githubcopilot.com/mcp/). A GitHub Enterprise deployment sets all
#   three. GITHUB_MCP_URL set to an empty value means there is no GitHub MCP
#   server: the connector can be linked but mounts no tools in chat. Leave the
#   line commented out for the default; an empty value is not the default.
# GITHUB_WEB_URL=https://github.com
# GITHUB_API_URL=https://api.github.com
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# - GITHUB_EVENT_INGEST_MODE (optional, default webhook): `poll` is for a
#   deployment GitHub cannot reach. The chat worker then reads each repository's
#   events feed with the trigger owner's token, /api/webhooks/github returns
#   404, and failed-CI triggers are refused (the feed has no workflow runs).
# GITHUB_EVENT_INGEST_MODE=webhook
# - WEB_FETCH_ENABLED (optional, default 1): set 0 to remove the URL fetch tool.
#   WEB_SEARCH_PROVIDER=none (or unset) removes web search.
# WEB_FETCH_ENABLED=1
# - ANALYTICS_PROVIDER (optional, default none): `posthog` turns product
#   analytics on and requires POSTHOG_PROJECT_TOKEN and POSTHOG_HOST. Read at
#   runtime; nothing is baked into the image.
# ANALYTICS_PROVIDER=none
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST=https://us.i.posthog.com
NEXTAUTH_SECRET=
GITHUB_AUTH_CLIENT_ID=
GITHUB_AUTH_CLIENT_SECRET=

# Sign-in provider allowlist (comma-separated). Known ids: "email" (magic
# links via SES — the universal tester path), "github" (optional secondary)
# and "pingone" (enterprise OIDC; any OpenID Connect issuer). Unknown ids are
# ignored with a warning; a list naming ONLY unknown ids disables sign-in
# (fail closed). Unset/blank = "github,email".
AUTH_PROVIDERS=github,email

# OIDC sign-in. Read only when AUTH_PROVIDERS names "pingone"; then the first
# three are required and the app refuses to boot without them. Register the
# redirect URI <NEXTAUTH_URL>/api/auth/callback/pingone with the issuer.
# - OIDC_REQUIRED_GROUP: only members may sign in. A missing or malformed
#   groups claim is refused.
# - OIDC_ADMIN_GROUP: an OIDC user is an admin exactly while in this group,
#   re-evaluated at every sign-in.
# - OIDC_ADOPT_EMAIL_USERS=1: an OIDC sign-in may take over an existing
#   magic-link user with the same address, only when the ID token carries
#   email_verified: true. Off by default.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# OIDC_GROUPS_CLAIM=groups
# OIDC_REQUIRED_GROUP=
# OIDC_ADMIN_GROUP=
# OIDC_ADOPT_EMAIL_USERS=0
# OIDC_DISPLAY_NAME=Single sign-on

# Magic-link restrictions (both optional). Domains are matched exactly;
# the sunset is the last day links work (YYYY-MM-DD, UTC).
# MAGIC_LINK_ALLOWED_DOMAINS=
# MAGIC_LINK_SUNSET=

# Idle session lifetime and cookie re-issue interval, in seconds.
# SESSION_MAX_AGE_SECONDS=86400
# SESSION_UPDATE_AGE_SECONDS=3600

# Postgres connection. docker-compose.yml provisions the local instance.
DATABASE_URL=postgres://aihub:aihub_dev@localhost:5432/aihub

# LLM client selector. `fake` echoes responses for local dev without AWS.
# `real` (lands in PR #7) calls AWS Bedrock.
BEDROCK_CLIENT=fake
# - BEDROCK_INFERENCE_PROFILE_PREFIX (optional, default `us.`): geo prefix sent
#   for models the registry spells with `us.`. One of `us.`, `eu.`, `global.`
#   or empty for in-region ids. Not every model is invocable under every prefix.
# BEDROCK_INFERENCE_PROFILE_PREFIX=us.

# GitHub OAuth App for the per-user MCP-token flow at /api/oauth/github/*.
# Distinct from GITHUB_AUTH_* — that one is for sign-in identity; this one is
# for issuing per-user GitHub tokens that the GitHub MCP server uses on the
# user's behalf. Scope is `repo read:user`.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signed GitHub repository webhook for skill event triggers (#293).
# Webhook URL: `${NEXTAUTH_URL}/api/webhooks/github`.
# Subscribe to pull_request_review and workflow_run events and use a random
# secret such as `openssl rand -hex 32`. This value belongs on the web task
# only; it is never passed to chat or memory workers.
GITHUB_WEBHOOK_SECRET=

# Notion OAuth integration for /api/oauth/notion/*.
# Configure the Notion app redirect URI as:
#   `${NEXTAUTH_URL}/api/oauth/notion/callback`.
# The OAuth connection stores delegated tokens in oauth_tokens. By default,
# chat mounts the first-party /api/mcp/notion endpoint and sends it the user's
# delegated bearer token for live Notion API reads/writes.
# Do not point this at https://mcp.notion.com/mcp; hosted Notion MCP performs
# its own OAuth handshake and is not compatible with Comparative-stored tokens.
# Leave NOTION_MCP_ENDPOINT_URL empty unless replacing the first-party endpoint
# with a compatible Comparative-owned gateway.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_API_VERSION=2026-03-11
NOTION_MCP_ENDPOINT_URL=

# Google OAuth integration for /api/oauth/google/*.
# Configure the Google OAuth app redirect URI as:
#   `${NEXTAUTH_URL}/api/oauth/google/callback`.
# This stores delegated read-only Gmail + Calendar tokens in oauth_tokens.
# Chat execution remains disabled until the Google Gateway/MCP target is wired.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Salesforce OAuth integration for /api/oauth/salesforce/*.
# Create an External Client App (or Connected App) with the authorization-code
# flow and callback `${NEXTAUTH_URL}/api/oauth/salesforce/callback`, scopes
# "api refresh_token". Tools are strictly read-only (#358).
# SALESFORCE_LOGIN_URL defaults to https://login.salesforce.com; override for
# sandboxes (https://test.salesforce.com) or a My Domain host.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# AES-256-GCM key (base64) for encrypting OAuth provider tokens at rest.
# Generate with `openssl rand -base64 32`. Required when provider OAuth routes
# such as /api/oauth/github/* or /api/oauth/notion/* are exercised; not required
# for sign-in.
OAUTH_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Agent runtime selector.
# ----------------------------------------------------------------------------
# Defaults to direct Bedrock. Set to `agentcore` for AWS-hosted worker agents.
RUNTIME=bedrock
RUNTIME_V2_DIRECT_MODEL_ID=auto
AGENTCORE_RUNTIME_ARN=
AGENTCORE_REGION=
AGENTCORE_QUALIFIER=

# Prompt/context guardrails for per-turn runtime execution.
# Current user message is always preserved; older context is bounded.
CHAT_RECENT_MESSAGE_LIMIT=12
CHAT_CONTEXT_CHAR_LIMIT=120000
CHAT_CONTEXT_MESSAGE_CHAR_LIMIT=24000

# Pilot request/cost guardrails. These are process-local today and should move
# to Redis/shared storage before horizontally scaled ECS/Fargate rollout.
# Allows one 10 MiB document after base64 + JSON overhead. Native images use
# Bedrock's lower 3.75 MB per-image limit.
CHAT_MAX_REQUEST_BYTES=16777216
CHAT_MAX_MESSAGE_CHARS=24000
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_REQUESTS=30

# Outbound email delivery (admin invitations AND magic-link sign-in mail —
# one configuration). Leave disabled locally unless SES is wired. Production
# should store these values in Secrets Manager / approved task env, use a
# verified SES sender or domain, and grant the task role ses:SendEmail.
# With the provider disabled, magic-link sign-in logs the link to the server
# console in non-production (so local dev can sign in) and fails loudly in
# production.
INVITE_EMAIL_PROVIDER=disabled
INVITE_EMAIL_FROM=
INVITE_EMAIL_AWS_REGION=

# Background chat-run worker. Local/App Runner can use the in-process bridge;
# ECS web tasks should set this to 0 and run the dedicated worker service.
CHAT_RUN_IN_PROCESS_WORKER=1
CHAT_RUN_WORKER_LEASE_MS=600000
CHAT_WORKER_RUNTIME_TIMEOUT_MS=3600000
WORKER_RUN_CONCURRENCY=3
CHAT_RUN_PROVIDER_POLL_INTERVAL_MS=15000
# A run that kills the worker process is re-claimed when its lease lapses.
# After this many claims it is quarantined instead, so one poison pill cannot
# occupy the lane forever.
CHAT_RUN_MAX_ATTEMPTS=3

# Vault memory capture. Local/App Runner can use the in-process scheduler:
# a successful chat queues capture work and runs a batch 20 minutes later.
# ECS web tasks should set this to 0 and run the dedicated memory worker.
MEMORY_CAPTURE_IN_PROCESS_SCHEDULER=1
MEMORY_CAPTURE_DELAY_MS=1200000
MEMORY_CAPTURE_WORKER_POLL_INTERVAL_MS=3600000
MEMORY_CAPTURE_BATCH_LIMIT=40
MEMORY_CAPTURE_PROCESSING_STALE_MS=1800000
MEMORY_CAPTURE_MODEL_ID=sonnet-4-5

# Optional web search (web__search, issue #313). The tool is hidden — never
# mounted, never listed in the preamble — unless BOTH are set. Provider must
# be `brave`; the key is a Brave Search API subscription token. Production
# should store the key in Secrets Manager, not task env.
WEB_SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
